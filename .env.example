# ELIAS — variáveis de ambiente (exemplo). Copie para .env e preencha.
# NUNCA comite .env com valores reais (Princípio 3 — Segurança por padrão).

# --- Provedor de LLM (Fase 0: Claude) ---
# Chave da API Anthropic. Obtida em https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelo padrão usado pelo adapter Claude
ELIAS_LLM_MODEL=claude-sonnet-5

# Provedor de LLM ativo (claude | openai). Fase 0 suporta apenas claude.
ELIAS_LLM_PROVIDER=claude

# --- Embeddings (ADR-0009: local por padrão, nada sai da máquina) ---
# Provedor ativo (local). openai/híbrido entram em fases futuras.
ELIAS_EMBEDDINGS_PROVIDER=local
# Modelo local (Hugging Face / ONNX). 1024 dimensões, multilíngue.
ELIAS_EMBEDDINGS_MODEL=Xenova/multilingual-e5-large
# Precisão dos pesos: q8 (quantizado, leve/rápido — padrão) | fp16 | fp32.
ELIAS_EMBEDDINGS_DTYPE=q8

# --- Supabase (projeto elias-core, sa-east-1) ---
SUPABASE_URL=https://zkldxpwufkaadnmvgjab.supabase.co
# Chave publicável (segura para clientes; respeita RLS)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_385KqS-bsjMW62sLOlFQFw_i3xcuO6S
# Chave de serviço: IGNORA RLS. Apenas no core/worker, jamais no cliente nem
# no repositório. Pegue em Supabase > Project Settings > API e coloque no .env.
SUPABASE_SERVICE_ROLE_KEY=

# --- Identidade do usuário local (ADR-0005) ---
# E-mail usado só pelo script one-shot `pnpm --filter @elias/scripts ensure-user`
# para provisionar/localizar o usuário real no Supabase Auth. Não é lido pelo CLI.
ELIAS_USER_EMAIL=
# user_id (uuid) devolvido pelo ensure-user. É o que o CLI usa de fato — toda
# memória (conversations/messages/memory_chunks) é escopada por ele.
ELIAS_USER_ID=

# --- Memória (ADR-0010: injeção de contexto no CLI) ---
# Máximo de trechos recuperados injetados como contexto por turno.
ELIAS_MEMORY_MATCH_COUNT=5
# Similaridade mínima (0-1) para um trecho ser considerado relevante o
# bastante para entrar no contexto.
ELIAS_MEMORY_MIN_SIMILARITY=0.5
