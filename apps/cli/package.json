{
  "name": "@elias/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "elias": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node --env-file=../../.env dist/main.js",
    "dev": "node --env-file=../../.env --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "@elias/core": "workspace:*",
    "@elias/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
