{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pnpm *)",
      "Bash(corepack *)",
      "Bash(node *)",
      "Bash(tsc *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git stash *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(rm *)",
      "Bash(supabase *)",
      "Bash(psql *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch",
      "Edit(.env)",
      "Edit(.env.*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)"
    ]
  }
}
